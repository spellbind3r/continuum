# Continuum Environment Configuration
# Copy this file to .env and fill in your actual values

# Anthropic API Key for LLM-enhanced "Dig Deeper" functionality
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_api_key_here

# Optional: Model to use (default: claude-3-5-sonnet-20241022)
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Optional: Enable LLM features (default: true if API key is set)
# ENABLE_LLM=true
